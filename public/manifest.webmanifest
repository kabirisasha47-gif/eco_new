{
  "id": "/",
  "name": "اکوسولار — مدیریت هوشمند انرژی خورشیدی",
  "short_name": "اکوسولار",
  "description": "اپلیکیشن مدیریت هوشمند نیروگاه خورشیدی خانگی، تحلیل قبض، انتخاب کانال درآمد و تطبیق صورتحساب خرید تضمینی.",
  "lang": "fa",
  "dir": "rtl",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#f4f4f4",
  "theme_color": "#f4f4f4",
  "categories": ["utilities", "finance", "productivity"],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "/manifest.webmanifest"
    }
  ],
  "icons": [
